#!/bin/bash
# Git pre-push hook: refuse to push a simulator state that has not passed scripts/gate.sh (all judging criteria on
# repeated official runs, determinism, tests, 16 scenarios).
#
# Install (once per clone; shared by all worktrees):  cp scripts/pre-push "$(git rev-parse --git-common-dir)/hooks/"
#
# A pushed commit passes if the tree of its differometor/ directory and the blob of benchmark.py appear in the
# ledger "$(git rev-parse --git-common-dir)/gate-passed", which scripts/gate.sh appends to after a full pass.
# Commits that change only docs/scripts/tests keep the same differometor/ tree and need no new gate run.
# Branches checked: GATED_BRANCHES (default: the-prime-model-new and main).
GATED_BRANCHES=${GATED_BRANCHES:-"the-prime-model-new main"}
LEDGER="$(git rev-parse --git-common-dir)/gate-passed"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                     # branch deletion
  branch=${remote_ref#refs/heads/}
  case " $GATED_BRANCHES " in *" $branch "*) ;; *) continue ;; esac
  tree=$(git rev-parse "$local_sha:differometor" 2>/dev/null)
  blob=$(git rev-parse "$local_sha:benchmark.py" 2>/dev/null)
  if [ -n "$tree" ] && [ -f "$LEDGER" ] && grep -q "^$tree $blob " "$LEDGER"; then
    echo "pre-push: $branch @ ${local_sha:0:7}: simulator tree ${tree:0:7} passed the correctness gate"
  else
    echo "pre-push: REFUSED $branch @ ${local_sha:0:7}: simulator tree ${tree:0:7} has not passed scripts/gate.sh" >&2
    echo "          run: srun --partition=short --cpus-per-task=2 --mem=48G --time=00:44:00 bash scripts/gate.sh" >&2
    status=1
  fi
done
exit $status
